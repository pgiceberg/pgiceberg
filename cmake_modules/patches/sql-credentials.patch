--- a/src/iceberg/catalog/sql/catalog_store_postgresql.cc
+++ b/src/iceberg/catalog/sql/catalog_store_postgresql.cc
@@ -19,6 +19,7 @@
 
 #include <exception>
 #include <memory>
+#include <charconv>
 #include <string_view>
 
 #include <sqlpp23/postgresql/postgresql.h>
@@ -70,6 +71,46 @@
   config->dbname = parsed.database;
   config->user = parsed.user;
   config->password = parsed.password;
+  // Keep credentials separate from the URI retained in catalog metadata/errors.
+  if (auto it = options.properties.find("user"); it != options.properties.end()) {
+    config->user = it->second;
+  }
+  if (auto it = options.properties.find("password"); it != options.properties.end()) {
+    config->password = it->second;
+  }
+
+  // sqlpp23 builds a libpq keyword string without escaping string values.
+  // Quote each field here so spaces, quotes and backslashes remain literal and
+  // cannot inject additional connection parameters.
+  const auto quote = [](const std::string& value) {
+    if (value.empty()) return value;
+    std::string result = "'";
+    for (char c : value) {
+      if (c == '\\' || c == '\'') result += '\\';
+      result += c;
+    }
+    return result + "'";
+  };
+  config->host = quote(config->host);
+  config->dbname = quote(config->dbname);
+  config->user = quote(config->user);
+  config->password = quote(config->password);
+  int connect_ms = 5000;
+  int request_ms = 30000;
+  for (auto [key, value] : {std::pair{"connect-timeout-ms", &connect_ms},
+                            std::pair{"request-timeout-ms", &request_ms}}) {
+    if (auto it = options.properties.find(key); it != options.properties.end()) {
+      auto [end, ec] = std::from_chars(it->second.data(),
+          it->second.data() + it->second.size(), *value);
+      if (ec != std::errc{} || end != it->second.data() + it->second.size() ||
+          *value < 1 || *value > 3600000) {
+        return InvalidArgument("Invalid SQL catalog timeout");
+      }
+    }
+  }
+  config->connect_timeout = (connect_ms + 999) / 1000;
+  config->options = quote("-c statement_timeout=" + std::to_string(request_ms) +
+                         " -c lock_timeout=" + std::to_string(connect_ms));
 
   try {
     if (options.max_connections > 1) {
@@ -83,7 +124,7 @@
     return std::make_shared<PostgresqlSingleCatalogStore>(options.catalog_name,
                                                           std::move(connection));
   } catch (const std::exception& e) {
-    return IOError("Failed to connect to PostgreSQL '{}': {}", options.uri, e.what());
+    return IOError("Failed to connect to PostgreSQL catalog");
   }
 }
 
