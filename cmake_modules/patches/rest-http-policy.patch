+Result<HttpClientOptions> HttpClientOptions::FromProperties(
+    const std::unordered_map<std::string, std::string>& properties) {
+  HttpClientOptions options;
+  struct Field {
+    const char* name;
+    int* value;
+    int min;
+    int max;
+  };
+  for (const auto field :
+       {Field{"rest.connect-timeout-ms", &options.connect_timeout_ms, 1, 3600000},
+        Field{"rest.request-timeout-ms", &options.request_timeout_ms, 1, 3600000},
+        Field{"rest.max-retries", &options.max_retries, 0, 10},
+        Field{"rest.retry-min-wait-ms", &options.retry_min_wait_ms, 1, 60000},
+        Field{"rest.retry-max-wait-ms", &options.retry_max_wait_ms, 1, 60000}}) {
+    if (auto it = properties.find(field.name); it != properties.end()) {
+      const auto& value = it->second;
+      auto [end, ec] =
+          std::from_chars(value.data(), value.data() + value.size(), *field.value);
+      if (ec != std::errc{} || end != value.data() + value.size() ||
+          *field.value < field.min || *field.value > field.max) {
+        return InvalidArgument("Invalid HTTP client property '{}'", field.name);
+      }
+    }
+  }
+  if (options.retry_min_wait_ms > options.retry_max_wait_ms) {
+    return InvalidArgument("HTTP retry minimum exceeds maximum wait");
+  }
+  return options;
+}
