+// Retry only operations whose repetition is safe. Catalog mutations deliberately
+// get one transport attempt, preserving unknown commit outcomes for recovery.
+template <typename Send>
+cpr::Response SendWithRetry(const HttpClientOptions& options, bool retryable, Send send) {
+  int delay_ms = options.retry_min_wait_ms;
+  for (int attempt = 0;; ++attempt) {
+    auto response = send();
+    const auto code = response.status_code;
+    const bool transient = code == 0 || code == 408 || code == 429 || code == 500 ||
+                           code == 502 || code == 503 || code == 504;
+    if (!retryable || !transient || attempt >= options.max_retries) return response;
+    int wait_ms = delay_ms;
+    if (auto it = response.header.find("Retry-After"); it != response.header.end()) {
+      int64_t seconds = 0;
+      const auto& value = it->second;
+      auto [end, ec] = std::from_chars(value.data(), value.data() + value.size(), seconds);
+      if (ec != std::errc{} || end != value.data() + value.size()) {
+        const auto deadline = curl_getdate(value.c_str(), nullptr);
+        if (deadline < 0) return response;
+        seconds = std::max<int64_t>(0, deadline - std::time(nullptr));
+      }
+      // Never retry earlier than Retry-After, or turn a bounded request into a
+      // long sleep. Let the caller retry later if the server's wait exceeds budget.
+      if (seconds < 0 || seconds > options.retry_max_wait_ms / 1000) return response;
+      wait_ms = std::max(wait_ms, static_cast<int>(seconds * 1000));
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(wait_ms));
+    delay_ms = std::min(options.retry_max_wait_ms, delay_ms * 2);
+  }
+}
 
