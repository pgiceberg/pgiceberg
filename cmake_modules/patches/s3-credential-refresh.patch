+// Keep the client alive until after the auth session has stopped its refresh task.
+struct StorageCredentialFetcher {
+  std::shared_ptr<const RestCatalog> owner;
+  std::shared_ptr<HttpClient> client;
+  std::shared_ptr<auth::AuthSession> session;
+  std::string uri;
+
+  Result<std::vector<StorageCredential>> Fetch() {
+    ICEBERG_ASSIGN_OR_RAISE(
+        auto response,
+        client->Get(uri, {}, {}, *DefaultErrorHandler::Instance(), *session));
+    try {
+      auto json = nlohmann::json::parse(response.body(), nullptr, false);
+      if (json.is_discarded() || !json.is_object() ||
+          !json.contains("storage-credentials") ||
+          !json["storage-credentials"].is_array()) {
+        return InvalidArgument("Invalid storage credential response");
+      }
+      std::vector<StorageCredential> credentials;
+      for (const auto& item : json["storage-credentials"]) {
+        if (!item.is_object() || !item.contains("prefix") ||
+            !item["prefix"].is_string() || !item.contains("config") ||
+            !item["config"].is_object()) {
+          return InvalidArgument("Invalid storage credential response");
+        }
+        StorageCredential credential;
+        credential.prefix = item["prefix"].get<std::string>();
+        for (const auto& [key, value] : item["config"].items()) {
+          if (!value.is_string())
+            return InvalidArgument("Invalid storage credential response");
+          credential.config[key] = value.get<std::string>();
+        }
+        ICEBERG_RETURN_UNEXPECTED(credential.Validate());
+        credentials.push_back(std::move(credential));
+      }
+      return credentials;
+    } catch (...) {
+      // JSON exceptions can quote input containing credentials.
+      return InvalidArgument("Invalid storage credential response");
+    }
+  }
+};
+
+Result<std::string> CredentialEndpoint(std::string_view catalog_uri,
+                                       std::string_view endpoint) {
+  const auto scheme = catalog_uri.find("://");
+  if (scheme == std::string_view::npos) return InvalidArgument("Invalid catalog URI");
+  const auto end = catalog_uri.find('/', scheme + 3);
+  const auto origin = catalog_uri.substr(0, end);
+  if (endpoint.find("://") != std::string_view::npos) {
+    if (!endpoint.starts_with(origin) || endpoint.size() <= origin.size() ||
+        endpoint[origin.size()] != '/') {
+      return InvalidArgument("Storage credential endpoint must use the catalog origin");
+    }
+    return std::string(endpoint);
+  }
+  if (endpoint.empty()) return InvalidArgument("Empty storage credential endpoint");
+  if (endpoint.starts_with('/')) return std::string(origin) + std::string(endpoint);
+  return std::string(TrimTrailingSlash(catalog_uri)) + '/' + std::string(endpoint);
+}
 
