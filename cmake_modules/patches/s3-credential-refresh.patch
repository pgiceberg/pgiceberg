+// A provider belongs to one Table FileIO. AWS consults it for every request,
+// including range reads and multipart writes from streams opened before expiry.
+struct RefreshingS3Credentials {
+  struct Entry {
+    Aws::Auth::AWSCredentials credentials;
+    int64_t expires_at = INT64_MAX;
+    int64_t refresh_at = INT64_MAX;
+  };
+  std::mutex mutex;
+  std::unordered_map<std::string, Entry> entries;
+  StorageCredentialRefresh refresh;
+  int64_t next_attempt_at = 0;
+
+  static int64_t Now() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+               std::chrono::system_clock::now().time_since_epoch())
+        .count();
+  }
+
+  static Result<std::unordered_map<std::string, Entry>> Parse(
+      const std::vector<StorageCredential>& credentials, bool refreshed) {
+    std::unordered_map<std::string, Entry> result;
+    const auto now = Now();
+    for (const auto& credential : credentials) {
+      ICEBERG_RETURN_UNEXPECTED(credential.Validate());
+      if (!IsS3CredentialPrefix(credential.prefix)) continue;
+      const auto* access = FindProperty(credential.config, S3Properties::kAccessKeyId);
+      const auto* secret =
+          FindProperty(credential.config, S3Properties::kSecretAccessKey);
+      const auto* token = FindProperty(credential.config, S3Properties::kSessionToken);
+      const auto* expiry =
+          FindProperty(credential.config, "s3.session-token-expires-at-ms");
+      if (!access || access->empty() || !secret || secret->empty()) {
+        return InvalidArgument(
+            "Storage credentials require an access key and secret key");
+      }
+      Entry entry{.credentials = Aws::Auth::AWSCredentials(
+                      access->c_str(), secret->c_str(), token ? token->c_str() : "")};
+      if (token && !token->empty()) {
+        // Unknown expiration: fetch on first use when a refresh endpoint exists.
+        entry.expires_at = -1;
+        entry.refresh_at = 0;
+      }
+      if (expiry) {
+        auto [end, ec] = std::from_chars(expiry->data(), expiry->data() + expiry->size(),
+                                         entry.expires_at);
+        if (ec != std::errc{} || end != expiry->data() + expiry->size() ||
+            entry.expires_at < 0) {
+          return InvalidArgument("Invalid storage credential expiration");
+        }
+        entry.refresh_at =
+            entry.expires_at -
+            std::min<int64_t>(30000, std::max<int64_t>(1, (entry.expires_at - now) / 5));
+      }
+      if (refreshed && (!expiry || !token || token->empty() || entry.expires_at <= now)) {
+        return InvalidArgument(
+            "Refreshed storage credentials must have a future expiration and session "
+            "token");
+      }
+      if (!result.emplace(CanonicalizeS3Scheme(credential.prefix), std::move(entry))
+               .second) {
+        return InvalidArgument("Duplicate storage credential prefix");
+      }
+    }
+    if (result.empty()) return InvalidArgument("No S3 credentials in refresh response");
+    return result;
+  }
+
+  Aws::Auth::AWSCredentials Get(const std::string& prefix) {
+    std::lock_guard lock(mutex);
+    auto now = Now();
+    auto found = entries.find(prefix);
+    if (found == entries.end()) return {};
+    if (refresh && now >= found->second.refresh_at && now >= next_attempt_at) {
+      // Single flight across prefixes. A failure can keep still-valid credentials,
+      // but cannot resurrect expired credentials or fall back to a process role.
+      next_attempt_at = now + 1000;
+      auto response = refresh();
+      if (response) {
+        auto parsed = Parse(*response, true);
+        if (parsed) {
+          entries = std::move(*parsed);
+          next_attempt_at = 0;
+        }
+      }
+      found = entries.find(prefix);
+      if (found == entries.end()) return {};
+      now = Now();
+    }
+    if (refresh && found->second.expires_at < 0) return {};
+    if (found->second.expires_at >= 0 && found->second.expires_at <= now) return {};
+    return found->second.credentials;
+  }
+};
+
+class RefreshingS3Provider : public Aws::Auth::AWSCredentialsProvider {
+ public:
+  RefreshingS3Provider(std::shared_ptr<RefreshingS3Credentials> state, std::string prefix)
+      : state_(std::move(state)), prefix_(std::move(prefix)) {}
+  Aws::Auth::AWSCredentials GetAWSCredentials() override {
+    // Empty credentials can cause the AWS signer to issue an anonymous request.
+    // Use an invalid explicit identity on failure, including for public buckets.
+    try {
+      auto credentials = state_->Get(prefix_);
+      if (!credentials.GetAWSAccessKeyId().empty() && !credentials.GetAWSSecretKey().empty()) {
+        return credentials;
+      }
+    } catch (...) {
+      // No exceptions or PostgreSQL calls may cross the AWS/Arrow worker boundary.
+    }
+    return Aws::Auth::AWSCredentials("pgiceberg-expired", "pgiceberg-expired", "pgiceberg-expired");
+  }
+
+ private:
+  std::shared_ptr<RefreshingS3Credentials> state_;
+  std::string prefix_;
+};
