\set VERBOSITY default
DROP SCHEMA dataset_imported CASCADE;
NOTICE:  drop cascades to foreign table dataset_imported.yellow_trip
DROP SERVER yellow_trip_dataset_server;
DROP EXTENSION pgiceberg;
