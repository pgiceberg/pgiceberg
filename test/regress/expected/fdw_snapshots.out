-- Practical FDW coverage for iceberg-cpp: multi-snapshot history, UseSnapshot
-- time travel, column projection, SAVEPOINT subtransactions, and metadata
-- summaries keyed by snapshot_id. Snapshot ids are random, so they are applied
-- through DO blocks and never printed in the expected output.
CREATE EXTENSION pgiceberg;
\pset format unaligned
\set VERBOSITY terse
\! rm -f /tmp/pgiceberg_catalog_snapshot_regress.db
\! rm -rf /tmp/pgiceberg_warehouse_snapshot_regress
DO $$
BEGIN
  PERFORM pgiceberg.add_catalog(
    'snapshot_regress',
    'sqlite',
    '/tmp/pgiceberg_catalog_snapshot_regress.db',
    '/tmp/pgiceberg_warehouse_snapshot_regress'
  );

  PERFORM pgiceberg.create_table(
    'snapshot_regress',
    'default',
    'snapshot_fixture',
    ARRAY['id', 'payload'],
    ARRAY['bigint'::regtype, 'text'::regtype],
    ARRAY[true, false],
    true
  );
END $$;
CREATE SERVER snapshot_iceberg
FOREIGN DATA WRAPPER pgiceberg
OPTIONS (catalog 'snapshot_regress');
CREATE FOREIGN TABLE snapshot_fixture (
  id bigint,
  payload text
)
SERVER snapshot_iceberg
OPTIONS (
  namespace 'default',
  table 'snapshot_fixture'
);
-- Reject dead / invalid option shortcuts at validation time.
CREATE FOREIGN TABLE snapshot_bad_id (
  id bigint,
  payload text
)
SERVER snapshot_iceberg
OPTIONS (
  namespace 'default',
  table 'snapshot_fixture',
  snapshot_id 'not-a-number'
);
ERROR:  invalid pgiceberg snapshot_id "not-a-number"
CREATE FOREIGN TABLE snapshot_config_file (
  id bigint,
  payload text
)
SERVER snapshot_iceberg
OPTIONS (
  namespace 'default',
  table 'snapshot_fixture',
  config_file '/tmp/unused.conf'
);
ERROR:  invalid pgiceberg option "config_file"
INSERT INTO snapshot_fixture VALUES (1, 'one');
SELECT
  (summary ->> 'snapshot_count')::integer AS snapshot_count,
  (summary ->> 'data_file_count')::integer AS data_file_count,
  (summary ->> 'delete_file_count')::integer AS delete_file_count,
  summary ->> 'snapshot_id' = summary ->> 'current_snapshot_id' AS is_current
FROM pgiceberg.table_snapshot_files_summary(
  'snapshot_regress',
  'default',
  'snapshot_fixture'
) AS summary;
snapshot_count|data_file_count|delete_file_count|is_current
1|1|0|t
(1 row)
INSERT INTO snapshot_fixture VALUES (2, 'two');
-- iceberg-cpp metadata helper for the oldest historical snapshot id.
WITH oldest AS (
  SELECT (metadata -> 'snapshots' -> 0 ->> 'snapshot-id')::bigint AS snapshot_id
  FROM (
    SELECT pgiceberg.table_metadata_json(
      'snapshot_regress',
      'default',
      'snapshot_fixture'
    ) AS metadata
  ) AS q
)
SELECT
  (summary ->> 'snapshot_id')::bigint = oldest.snapshot_id AS historical_summary,
  (summary ->> 'snapshot_count')::integer AS snapshot_count,
  summary ->> 'snapshot_id' = summary ->> 'current_snapshot_id' AS is_current,
  (summary ->> 'data_file_count')::integer AS data_file_count
FROM oldest,
LATERAL pgiceberg.table_snapshot_files_summary(
  'snapshot_regress',
  'default',
  'snapshot_fixture',
  oldest.snapshot_id
) AS summary;
historical_summary|snapshot_count|is_current|data_file_count
t|2|f|1
(1 row)
-- Current table has both rows; column projection still reads through iceberg-cpp Select.
SELECT id
FROM snapshot_fixture
ORDER BY id;
id
1
2
(2 rows)
SELECT count(*) AS current_row_count
FROM snapshot_fixture;
current_row_count
2
(1 row)
-- Pin UseSnapshot to the first commit and verify time travel.
DO $$
DECLARE
  snap bigint;
BEGIN
  SELECT (metadata -> 'snapshots' -> 0 ->> 'snapshot-id')::bigint
  INTO snap
  FROM (
    SELECT pgiceberg.table_metadata_json(
      'snapshot_regress',
      'default',
      'snapshot_fixture'
    ) AS metadata
  ) AS q;

  EXECUTE format(
    'ALTER FOREIGN TABLE snapshot_fixture OPTIONS (ADD snapshot_id %L)',
    snap::text
  );
END $$;
SELECT id, payload
FROM snapshot_fixture
ORDER BY id;
id|payload
1|one
(1 row)
SELECT count(*) AS historical_row_count
FROM snapshot_fixture;
historical_row_count
1
(1 row)
-- DML against a pinned historical snapshot must fail cleanly.
INSERT INTO snapshot_fixture VALUES (3, 'three');
ERROR:  pgiceberg DML is not supported when foreign table option "snapshot_id" is set
ALTER FOREIGN TABLE snapshot_fixture
OPTIONS (DROP snapshot_id);
-- After dropping the pin, the current snapshot is visible again.
SELECT id, payload
FROM snapshot_fixture
ORDER BY id;
id|payload
1|one
2|two
(2 rows)
-- SAVEPOINT rollback rebuilds pending Iceberg transaction state.
BEGIN;
INSERT INTO snapshot_fixture VALUES (3, 'three');
SAVEPOINT keep_three;
INSERT INTO snapshot_fixture VALUES (4, 'four');
SELECT id FROM snapshot_fixture ORDER BY id;
id
1
2
3
4
(4 rows)
ROLLBACK TO SAVEPOINT keep_three;
SELECT id FROM snapshot_fixture ORDER BY id;
id
1
2
3
(3 rows)
COMMIT;
SELECT id, payload
FROM snapshot_fixture
ORDER BY id;
id|payload
1|one
2|two
3|three
(3 rows)
CREATE TEMP TABLE snapshot_regress_ids (
  snap_before_delete bigint NOT NULL
);
INSERT INTO snapshot_regress_ids (snap_before_delete)
SELECT (summary ->> 'snapshot_id')::bigint
FROM pgiceberg.table_snapshot_files_summary(
  'snapshot_regress',
  'default',
  'snapshot_fixture'
) AS summary;
DELETE FROM snapshot_fixture WHERE id = 1;
SELECT id, payload
FROM snapshot_fixture
ORDER BY id;
id|payload
2|two
3|three
(2 rows)
-- Historical snapshot still contains the deleted row; current does not.
DO $$
DECLARE
  snap bigint;
BEGIN
  SELECT snap_before_delete INTO snap FROM snapshot_regress_ids;
  EXECUTE format(
    'ALTER FOREIGN TABLE snapshot_fixture OPTIONS (ADD snapshot_id %L)',
    snap::text
  );
END $$;
SELECT id
FROM snapshot_fixture
ORDER BY id;
id
1
2
3
(3 rows)
ALTER FOREIGN TABLE snapshot_fixture
OPTIONS (DROP snapshot_id);
SELECT
  (summary ->> 'snapshot_count')::integer >= 4 AS has_snapshot_history,
  (summary ->> 'data_file_count')::integer AS data_file_count,
  summary ->> 'snapshot_id' = summary ->> 'current_snapshot_id' AS is_current
FROM pgiceberg.table_snapshot_files_summary(
  'snapshot_regress',
  'default',
  'snapshot_fixture'
) AS summary;
has_snapshot_history|data_file_count|is_current
t|1|t
(1 row)
-- Missing snapshot id surfaces through iceberg-cpp scan planning.
ALTER FOREIGN TABLE snapshot_fixture
OPTIONS (ADD snapshot_id '1');
SELECT count(*) FROM snapshot_fixture;
ERROR:  load snapshot by id: Snapshot with ID 1 is not found
ALTER FOREIGN TABLE snapshot_fixture
OPTIONS (DROP snapshot_id);
\set VERBOSITY default
DROP FOREIGN TABLE snapshot_fixture;
DROP SERVER snapshot_iceberg;
DROP EXTENSION pgiceberg;
